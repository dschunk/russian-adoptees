{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "russian-adoptees",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "contact@russianadoptees.com"
      ]
    }
  ]
}
