{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "russian-adoptees",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CASE_STORE",
        "class_name": "CaseStore"
      }
    ]
  },
  "exports": {
    "CaseStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "contact@russianadoptees.com"
      ]
    }
  ]
}
